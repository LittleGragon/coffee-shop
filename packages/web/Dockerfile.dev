# Web Frontend Development Dockerfile (Next.js + Prisma)
FROM node:20-alpine

WORKDIR /app

# Install root deps (workspace-aware)
COPY package.json package-lock.json ./
RUN npm ci

# Copy only web package manifest to install its deps if needed
COPY packages/web/package.json ./packages/web/package.json
RUN npm install --workspace=packages/web --ignore-scripts

# Copy source
COPY packages/web ./packages/web

# Ensure Prisma client is generated
WORKDIR /app/packages/web
RUN npx prisma generate || true

# Next dev on 0.0.0.0:3002
ENV PORT=3002
EXPOSE 3002

CMD ["npx", "--yes", "next@15.4.5", "dev", "-p", "3002", "-H", "0.0.0.0"]

{
  "name": "coffee-shop-buddy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm-run-all -p build:*",
    "build:web": "npm run build --workspace=coffee-shop-buddy",
    "build:github_pages": "npm run build:github_pages --workspace=coffee-shop-buddy",
    "build:api": "npm run build --workspace=api",
    "build:coffee-shop-ops": "npm run build --workspace=coffee-shop-ops",
    "build:bff": "npm run build --workspace=coffee-shop-bff",
    "dev": "npm-run-all -p dev:*",
    "dev:web": "npm run dev --workspace=coffee-shop-buddy",
    "dev:api": "npm run dev --workspace=api",
    "dev:coffee-shop-ops": "npm run dev --workspace=coffee-shop-ops",
    "dev:bff": "npm run dev --workspace=coffee-shop-bff",
    "start": "npm run start --workspace=api",
    "start:coffee-shop-ops": "npm run start --workspace=coffee-shop-ops",
    "start:bff": "npm run start --workspace=coffee-shop-bff",
    "test": "npm-run-all -p test:*",
    "test:api": "npm run test --workspace=api",
    "test:coffee-shop-ops": "npm run test --workspace=coffee-shop-ops",
    "test:bff": "npm run test --workspace=coffee-shop-bff",
    "prisma:generate": "npm run prisma:generate --workspace=coffee-shop-bff",
    "prisma:migrate": "npm run prisma:migrate --workspace=coffee-shop-bff",
    "prisma:studio": "npm run prisma:studio --workspace=coffee-shop-bff",
    "prepare": "husky"
  },
  "devDependencies": {
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5"
  }
}

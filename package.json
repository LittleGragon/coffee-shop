{
  "name": "coffee-shop-buddy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm-run-all -p build:*",
    "build:web": "npm run build --workspace=web",
    "build:github_pages": "npm run build:github_pages --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:coffee-shop-ops": "npm run build --workspace=coffee-shop-ops",
    "dev": "npm-run-all -p dev:*",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:coffee-shop-ops": "npm run dev --workspace=coffee-shop-ops",
    "start": "npm run start --workspace=api",
    "start:coffee-shop-ops": "npm run start --workspace=coffee-shop-ops",
    "test": "npm-run-all -p test:*",
    "test:api": "npm run test --workspace=api",
    "test:coffee-shop-ops": "npm run test --workspace=coffee-shop-ops",
    "prepare": "husky",
    "ops": "bash scripts/ops.sh",
    "docker:up": "bash scripts/ops.sh docker up",
    "docker:down": "bash scripts/ops.sh docker down",
    "docker:build": "bash scripts/ops.sh docker build",
    "docker:logs": "bash scripts/ops.sh docker logs",
    "docker:dev:up": "bash scripts/ops.sh docker up --dev",
    "docker:dev:down": "bash scripts/ops.sh docker down --dev",
    "docker:localdb:up": "bash scripts/ops.sh docker up --local-db",
    "docker:localdb:down": "bash scripts/ops.sh docker down --local-db",
    "k8s:apply": "bash scripts/ops.sh k8s apply",
    "k8s:delete": "bash scripts/ops.sh k8s delete",
    "k8s:status": "bash scripts/ops.sh k8s status"
  },
  "devDependencies": {
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5"
  }
}
